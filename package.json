{
  "name": "opencode-autocontinue",
  "version": "0.3.14",
  "description": "OpenCode V2 plugin: auto-resume sessions interrupted before the overall task is done (model errors like bad_response_status_code, stage-complete idle, network blips). Per-session manual opt-in via /autocontinue, TUI footer status, retry hook, configurable message/time-window/limits.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build:tui": "npx esbuild src/tui.tsx --bundle --format=esm --platform=node --target=es2022 --jsx=automatic --external:@opencode/* --external:@opentui/* --external:solid-js --external:solid-js/* --outfile=dist/tui.js"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "test",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "auto-continue",
    "session-recovery",
    "night-shift",
    "watchdog"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  }
}